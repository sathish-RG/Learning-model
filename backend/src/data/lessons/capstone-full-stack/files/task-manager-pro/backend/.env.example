# Copy this file to .env and fill it in. Never commit .env: it holds your secrets.

# Your MongoDB connection string:
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/task-manager-pro
#   Local:  mongodb://127.0.0.1:27017/task-manager-pro
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager-pro

# A long random secret for signing login tokens. Make your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

PORT=5000
NODE_ENV=development
