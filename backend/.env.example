# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/devprep

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Auth cookie SameSite policy: lax (default; frontend and API on the same site),
# or none (frontend on a different site; requires HTTPS and CSRF protection)
COOKIE_SAME_SITE=lax
